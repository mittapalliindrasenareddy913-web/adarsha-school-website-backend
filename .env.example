PORT=5000
NODE_ENV=production

# MongoDB Atlas Production URI
MONGODB_URI=your_mongodb_atlas_uri_here

# Cloudflare R2 Bucket Credentials
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=adarsha-school-media
R2_PUBLIC_BASE_URL=your_r2_public_domain_url

# Security & Admin Setup
ADMIN_EMAIL=admin@adarshaemschool.edu.in
ADMIN_PASSWORD=your_admin_secure_password
JWT_SECRET=your_jwt_secret_key

# CORS Allowed Frontend Origin
FRONTEND_URL=https://adarsha-school.netlify.app
